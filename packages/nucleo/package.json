{
  "name": "@ahrena-console/nucleo",
  "version": "0.0.21",
  "description": "Núcleo do Ahrena Console: modelo de dados, portas e adaptadores",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./simulator": "./src/simulator/index.ts",
    "./api": "./src/api/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./owner": "./src/owner/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "simulate": "node --disable-warning=ExperimentalWarning src/simulator/cli.ts",
    "api": "node --disable-warning=ExperimentalWarning src/api/cli.ts",
    "mcp": "node --disable-warning=ExperimentalWarning src/mcp/cli.ts",
    "core": "node --disable-warning=ExperimentalWarning src/owner/cli.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.20.2"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0"
  }
}
