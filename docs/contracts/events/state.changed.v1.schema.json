{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahrenatechnology/ahrena-console/blob/main/docs/contracts/events/state.changed.v1.schema.json",
  "title": "state.changed.v1 data",
  "description": "A session's persisted state changed. Subject: the session id.",
  "type": "object",
  "required": [
    "sessionId",
    "accountId"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "accountId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
